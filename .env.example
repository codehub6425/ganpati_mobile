# MySQL (WAMP)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ganpti_mobile

# Shared Machwale WhatsApp gateway — HTTP API only (no PHP/Laravel code imported into Ganpati).
# Run separately: cd C:\wamp64\www\machwale_admin\whatsapp-gateway && npm start  (listens on PORT, default 3001)
# Ganpati Next.js should stay on port 3000 so it does not collide with the gateway.
WHATSAPP_GATEWAY_URL=http://127.0.0.1:3001
# Must match whatsapp-gateway/.env → GATEWAY_SECRET (exact same string; cannot be blank)
WHATSAPP_GATEWAY_SECRET=changeme-local
WHATSAPP_SHOP_ID=100
WHATSAPP_GATEWAY_TIMEOUT=8
WHATSAPP_GATEWAY_SEND_TIMEOUT=60

# Bill template placeholders
SHOP_NAME=Ganpati Mobile Point
SHOP_PHONE=

# Product images (local disk; S3-ready keys under storage/media)
MEDIA_LOCAL_ROOT=./storage/media
# Product cover: resized + WebP; typical saved size ~50–200 KB
MEDIA_WEBP_QUALITY=72
MEDIA_MAX_EDGE=800
MEDIA_MAX_OUTPUT_KB=200
MEDIA_WEBP_EFFORT=6
MEDIA_MAX_UPLOAD_BYTES=8388608
# MEDIA_CDN_BASE=https://your-cdn.example.com
# MEDIA_DRIVER=local
