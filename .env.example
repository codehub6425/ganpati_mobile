# MySQL (WAMP)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ganpti_mobile

# Shared Machwale WhatsApp gateway — HTTP API only (no PHP/Laravel code imported into Ganpati).
# Run separately: cd C:\wamp64\www\machwale_admin\whatsapp-gateway && npm start  (listens on PORT, default 3001)
# Ganpati Next.js should stay on port 3000 so it does not collide with the gateway.
WHATSAPP_GATEWAY_URL=http://127.0.0.1:3001
# Required for Settings → WhatsApp (must match whatsapp-gateway secret; cannot be blank)
WHATSAPP_GATEWAY_SECRET=changeme-use-same-on-gateway
WHATSAPP_SHOP_ID=100
WHATSAPP_GATEWAY_TIMEOUT=8
WHATSAPP_GATEWAY_SEND_TIMEOUT=60

# Bill template placeholders
SHOP_NAME=Ganpati Mobile Point
SHOP_PHONE=
